<?xml version="1.0" encoding="utf-8"?>
<!--
  xArm6 URDF for PyBullet inverse dynamics (gravity compensation).

  Source: xArm-Developer/xarm_ros2  xarm_description/config/link_inertial/xarm6_type6_HT_BR2.yaml
  Mass, center-of-mass, and inertia tensor values for links 1-6 taken from
  the official UFACTORY xarm_ros2 repository (model: xarm6_type6_HT_BR2).
  link_eef represents the xArm Gripper G2 (0.80 kg).

  Visual/collision geometries use simple cylinders/boxes so no mesh files are
  needed.  This is sufficient for PyBullet calculateInverseDynamics().
-->
<robot name="xarm6">

  <!-- ============================================================ -->
  <!-- Materials                                                      -->
  <!-- ============================================================ -->
  <material name="Black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>
  <material name="Silver">
    <color rgba="0.75 0.75 0.75 1.0"/>
  </material>
  <material name="White">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>

  <!-- ============================================================ -->
  <!-- world link (fixed base)                                        -->
  <!-- ============================================================ -->
  <link name="world"/>
  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="link_base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- link_base                                                      -->
  <!-- ============================================================ -->
  <link name="link_base">
    <inertial>
      <origin xyz="0.0 0.0 0.09103" rpy="0 0 0"/>
      <mass value="2.7"/>
      <inertia ixx="0.00494875" ixy="-3.5e-06" ixz="1.25e-05"
               iyy="0.00494174" iyz="1.67e-06" izz="0.002219"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.1335" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.050" length="0.267"/>
      </geometry>
      <material name="White"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.1335" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.050" length="0.267"/>
      </geometry>
    </collision>
  </link>

  <!-- ============================================================ -->
  <!-- joint1  (base -> link1)                                        -->
  <!-- ============================================================ -->
  <joint name="joint1" type="revolute">
    <parent link="link_base"/>
    <child link="link1"/>
    <origin xyz="0 0 0.267" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307" upper="6.283185307" effort="50.0" velocity="3.14"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- link1                                                          -->
  <!-- ============================================================ -->
  <link name="link1">
    <inertial>
      <origin xyz="0.00022 0.02951 -0.0124" rpy="0 0 0"/>
      <mass value="2.3814"/>
      <inertia ixx="0.0058562" ixy="-1.79e-05" ixz="3.55e-06"
               iyy="0.0050316"  iyz="-0.000888336"   izz="0.003536652"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.08"/>
      </geometry>
      <material name="Silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.08"/>
      </geometry>
    </collision>
  </link>

  <!-- ============================================================ -->
  <!-- joint2  (link1 -> link2)                                       -->
  <!-- ============================================================ -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.059" upper="2.0944" effort="50.0" velocity="3.14"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- link2                                                          -->
  <!-- ============================================================ -->
  <link name="link2">
    <inertial>
      <origin xyz="0.03881 -0.22783 0.03496" rpy="0 0 0"/>
      <mass value="2.2675"/>
      <inertia ixx="0.028315776"  ixy="0.005" ixz="0.00066546"
               iyy="0.0058" iyz="-0.0045741"   izz="0.0273447"/>
    </inertial>
    <visual>
      <origin xyz="0.02675 -0.14225 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.2845 0.06"/>
      </geometry>
      <material name="White"/>
    </visual>
    <collision>
      <origin xyz="0.02675 -0.14225 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.2845 0.06"/>
      </geometry>
    </collision>
  </link>

  <!-- ============================================================ -->
  <!-- joint3  (link2 -> link3)                                       -->
  <!-- ============================================================ -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.0535 -0.2845 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.927" upper="0.19198" effort="32.0" velocity="3.14"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- link3                                                          -->
  <!-- ============================================================ -->
  <link name="link3">
    <inertial>
      <origin xyz="0.07041 0.11631 0.0107" rpy="0 0 0"/>
      <mass value="1.875"/>
      <inertia ixx="0.0063483"  ixy="-0.0015397"   ixz="0.00096858"
               iyy="0.00379758"  iyz="0.00186567"  izz="0.00595768"/>
    </inertial>
    <visual>
      <origin xyz="0.03875 0.17125 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.3425 0.06"/>
      </geometry>
      <material name="Silver"/>
    </visual>
    <collision>
      <origin xyz="0.03875 0.17125 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.3425 0.06"/>
      </geometry>
    </collision>
  </link>

  <!-- ============================================================ -->
  <!-- joint4  (link3 -> link4)                                       -->
  <!-- ============================================================ -->
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0.0775 0.3425 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307" upper="6.283185307" effort="32.0" velocity="3.14"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- link4                                                          -->
  <!-- ============================================================ -->
  <link name="link4">
    <inertial>
      <origin xyz="-0.00018 0.01798 -0.02291" rpy="0 0 0"/>
      <mass value="1.3192"/>
      <inertia ixx="0.004896" ixy="-6.925e-06" ixz="-1.418e-05"
               iyy="0.00445694"  iyz="-0.00023186" izz="0.00134332"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.040" length="0.08"/>
      </geometry>
      <material name="White"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.040" length="0.08"/>
      </geometry>
    </collision>
  </link>

  <!-- ============================================================ -->
  <!-- joint5  (link4 -> link5)                                       -->
  <!-- ============================================================ -->
  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.69297" upper="3.141592653" effort="32.0" velocity="3.14"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- link5                                                          -->
  <!-- ============================================================ -->
  <link name="link5">
    <inertial>
      <origin xyz="0.0651 0.03096 0.00315" rpy="0 0 0"/>
      <mass value="1.33854"/>
      <inertia ixx="0.00146378" ixy="-0.000450624" ixz="0.000284306"
               iyy="0.00184192"   iyz="0.000130866"   izz="0.002333524"/>
    </inertial>
    <visual>
      <origin xyz="0.038 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.076 0.05 0.05"/>
      </geometry>
      <material name="Silver"/>
    </visual>
    <collision>
      <origin xyz="0.038 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.076 0.05 0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- ============================================================ -->
  <!-- joint6  (link5 -> link6)                                       -->
  <!-- ============================================================ -->
  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0.076 0.097 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307" upper="6.283185307" effort="20.0" velocity="3.14"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- link6                                                          -->
  <!-- ============================================================ -->
  <link name="link6">
    <inertial>
      <origin xyz="0 -0.00677 -0.01098" rpy="0 0 0"/>
      <mass value="0.17"/>
      <inertia ixx="9.3e-05" ixy="0"          ixz="0"
               iyy="5.87e-05" iyz="-3.6e-06"           izz="0.000132"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.032" length="0.02"/>
      </geometry>
      <material name="Black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.032" length="0.02"/>
      </geometry>
    </collision>
  </link>

  <!-- ============================================================ -->
  <!-- End effector (fixed)                                           -->
  <!-- ============================================================ -->
  <joint name="joint_eef" type="fixed">
    <parent link="link6"/>
    <child link="link_eef"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="link_eef">
    <inertial>
      <origin xyz="0.12 -0.04 0.158" rpy="0 0 0"/>
      <mass value="0.78"/>
      <inertia ixx="0.0008" ixy="0" ixz="0"
               iyy="0.0008" iyz="0" izz="0.0004"/>
    </inertial>
  </link>

</robot>
