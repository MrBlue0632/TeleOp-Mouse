<?xml version="1.0" encoding="utf-8"?>
<!--
  xArm6 URDF for PyBullet inverse dynamics (gravity compensation).

  Source: xArm-Developer/xarm_ros2  xarm_description/urdf/xarm6/xarm6.urdf.xacro
  All kinematic (DH), mass, center-of-mass, and inertia tensor values are taken
  directly from the official UFACTORY xarm_ros2 repository (default model:
  xarm6_type6_HT_BR2).

  Visual/collision geometries use simple cylinders/boxes so no mesh files are
  needed.  This is sufficient for PyBullet calculateInverseDynamics().
-->
<robot name="xarm6">

  <!-- ============================================================ -->
  <!-- Materials                                                      -->
  <!-- ============================================================ -->
  <material name="Black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>
  <material name="Silver">
    <color rgba="0.75 0.75 0.75 1.0"/>
  </material>
  <material name="White">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>

  <!-- ============================================================ -->
  <!-- world link (fixed base)                                        -->
  <!-- ============================================================ -->
  <link name="world"/>
  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="link_base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- link_base                                                      -->
  <!-- ============================================================ -->
  <link name="link_base">
    <inertial>
      <origin xyz="0.0 0.0 0.09103" rpy="0 0 0"/>
      <mass value="2.7"/>
      <inertia ixx="0.00494875" ixy="-3.5e-06" ixz="1.25e-05"
               iyy="0.00494174" iyz="1.67e-06" izz="0.002219"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.1335" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.050" length="0.267"/>
      </geometry>
      <material name="White"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.1335" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.050" length="0.267"/>
      </geometry>
    </collision>
  </link>

  <!-- ============================================================ -->
  <!-- joint1  (base -> link1)                                        -->
  <!-- ============================================================ -->
  <joint name="joint1" type="revolute">
    <parent link="link_base"/>
    <child link="link1"/>
    <origin xyz="0 0 0.267" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307" upper="6.283185307" effort="50.0" velocity="3.14"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- link1                                                          -->
  <!-- ============================================================ -->
  <link name="link1">
    <inertial>
      <origin xyz="-0.002 0.02692 -0.01332" rpy="0 0 0"/>
      <mass value="2.16"/>
      <inertia ixx="0.00539427" ixy="1.095e-05" ixz="1.635e-06"
               iyy="0.0048979"  iyz="0.000793"   izz="0.00311573"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.08"/>
      </geometry>
      <material name="Silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.08"/>
      </geometry>
    </collision>
  </link>

  <!-- ============================================================ -->
  <!-- joint2  (link1 -> link2)                                       -->
  <!-- ============================================================ -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.059" upper="2.0944" effort="50.0" velocity="3.14"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- link2                                                          -->
  <!-- ============================================================ -->
  <link name="link2">
    <inertial>
      <origin xyz="0.03531 -0.21398 0.03386" rpy="0 0 0"/>
      <mass value="1.71"/>
      <inertia ixx="0.0248674"  ixy="-0.00430651" ixz="-0.00067797"
               iyy="0.00485548" iyz="0.00457245"   izz="0.02387827"/>
    </inertial>
    <visual>
      <origin xyz="0.02675 -0.14225 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.2845 0.06"/>
      </geometry>
      <material name="White"/>
    </visual>
    <collision>
      <origin xyz="0.02675 -0.14225 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.2845 0.06"/>
      </geometry>
    </collision>
  </link>

  <!-- ============================================================ -->
  <!-- joint3  (link2 -> link3)                                       -->
  <!-- ============================================================ -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.0535 -0.2845 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.927" upper="0.19198" effort="32.0" velocity="3.14"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- link3                                                          -->
  <!-- ============================================================ -->
  <link name="link3">
    <inertial>
      <origin xyz="0.06781 0.10749 0.01457" rpy="0 0 0"/>
      <mass value="1.384"/>
      <inertia ixx="0.0053694"  ixy="0.0014185"   ixz="-0.00092094"
               iyy="0.0032423"  iyz="-0.00169178"  izz="0.00501731"/>
    </inertial>
    <visual>
      <origin xyz="0.03875 0.17125 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.3425 0.06"/>
      </geometry>
      <material name="Silver"/>
    </visual>
    <collision>
      <origin xyz="0.03875 0.17125 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.3425 0.06"/>
      </geometry>
    </collision>
  </link>

  <!-- ============================================================ -->
  <!-- joint4  (link3 -> link4)                                       -->
  <!-- ============================================================ -->
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0.0775 0.3425 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307" upper="6.283185307" effort="32.0" velocity="3.14"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- link4                                                          -->
  <!-- ============================================================ -->
  <link name="link4">
    <inertial>
      <origin xyz="-0.00021 0.02578 -0.02538" rpy="0 0 0"/>
      <mass value="1.115"/>
      <inertia ixx="0.00439263" ixy="5.028e-05" ixz="1.374e-05"
               iyy="0.0040077"  iyz="0.00045338" izz="0.00110321"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.040" length="0.08"/>
      </geometry>
      <material name="White"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.040" length="0.08"/>
      </geometry>
    </collision>
  </link>

  <!-- ============================================================ -->
  <!-- joint5  (link4 -> link5)                                       -->
  <!-- ============================================================ -->
  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.69297" upper="3.141592653" effort="32.0" velocity="3.14"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- link5                                                          -->
  <!-- ============================================================ -->
  <link name="link5">
    <inertial>
      <origin xyz="0.05428 0.01781 0.00543" rpy="0 0 0"/>
      <mass value="1.275"/>
      <inertia ixx="0.001202758" ixy="0.000492428" ixz="-0.00039147"
               iyy="0.0022876"   iyz="-1.235e-04"   izz="0.0026866"/>
    </inertial>
    <visual>
      <origin xyz="0.038 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.076 0.05 0.05"/>
      </geometry>
      <material name="Silver"/>
    </visual>
    <collision>
      <origin xyz="0.038 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.076 0.05 0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- ============================================================ -->
  <!-- joint6  (link5 -> link6)                                       -->
  <!-- ============================================================ -->
  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0.076 0.097 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307" upper="6.283185307" effort="20.0" velocity="3.14"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- link6                                                          -->
  <!-- ============================================================ -->
  <link name="link6">
    <inertial>
      <origin xyz="0 0.00064 -0.00952" rpy="0 0 0"/>
      <mass value="0.1096"/>
      <inertia ixx="4.5293e-05" ixy="0"          ixz="0"
               iyy="4.8111e-05" iyz="0"           izz="7.9715e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.032" length="0.02"/>
      </geometry>
      <material name="Black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.032" length="0.02"/>
      </geometry>
    </collision>
  </link>

  <!-- ============================================================ -->
  <!-- End effector (fixed)                                           -->
  <!-- ============================================================ -->
  <joint name="joint_eef" type="fixed">
    <parent link="link6"/>
    <child link="link_eef"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="link_eef">
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="0.70"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

</robot>
